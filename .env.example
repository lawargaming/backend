# ============================================================
# ENVIRONMENT
# ============================================================
NODE_ENV=development
# Nilai yang valid: development | staging | production

# ============================================================
# SERVER
# ============================================================
PORT=4000
HOST=0.0.0.0
# Batas ukuran request body (default: 10mb)
BODY_LIMIT=10mb

# ============================================================
# DATABASE (MongoDB)
# ============================================================
MONGO_URI=mongodb://127.0.0.1:27017/db_produk
# Contoh production: mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>

# ============================================================
# CACHE (Redis)
# ============================================================
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# AUTHENTICATION
# ============================================================
JWT_SECRET=
JWT_REFRESH_SECRET=
# Durasi token: contoh 1h, 7d, 30d
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================
# SENTRY – Error Tracking & Performance Monitoring
# ============================================================
# DSN (Data Source Name): dapatkan dari https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=https://ccf26b6731ca97b38e209fa4f54e007f@o4511156815986688.ingest.us.sentry.io/4511156853538816

# Environment yang akan ditampilkan di Sentry dashboard
# (otomatis diambil dari NODE_ENV jika tidak di-set)
SENTRY_ENVIRONMENT=development

# Release version – berguna untuk track error per versi aplikasi
# Format: "backend@1.0.0" atau commit SHA
# Bisa di-set otomatis dari package.json: npm_package_version
SENTRY_RELEASE=

# Sample rate untuk performance tracing (0.0 - 1.0)
# development: 1.0 (semua), staging: 0.5, production: 0.1
SENTRY_TRACES_SAMPLE_RATE=1.0

# Sample rate untuk CPU profiling (0.0 - 1.0)
# Rekomendasi production: 0.1, development: 0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Mode debug Sentry – tampilkan log internal Sentry di console
# Set true hanya saat debugging Sentry config (matikan di production!)
SENTRY_DEBUG=false

# ============================================================
# CORS
# ============================================================
# Daftar origin yang diizinkan, dipisah koma
# Contoh: http://localhost:3000,https://app.lawargaming.com
# Gunakan * untuk allow semua (TIDAK DISARANKAN di production!)
CORS_ORIGIN=http://localhost:3000

# ============================================================
# RATE LIMITING
# ============================================================
# Window time dalam milidetik (default: 15 menit = 900000 ms)
RATE_LIMIT_WINDOW_MS=900000
# Maksimal request per window per IP (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# Rate limit ketat untuk endpoint auth (login, register, dll.)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

